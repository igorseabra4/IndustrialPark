<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>preview</LangVersion>
    <OutputType>WinExe</OutputType>
    <RootNamespace>IndustrialParkRandomizer</RootNamespace>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\IndustrialPark\bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <OutputPath>..\IndustrialPark\bin\Release\</OutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject>IndustrialPark.Randomizer.Program</StartupObject>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Copyright>Copyright ©  2019</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HipHopTool\HipHopFile\HipHopFile.csproj" />
    <ProjectReference Include="..\IndustrialPark\IndustrialPark.csproj" />
    <ProjectReference Include="..\RenderWareFile\RenderWareFile\RenderWareFile.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="WindowsAPICodePack-Core" Version="1.1.2" />
    <PackageReference Include="WindowsAPICodePack-Shell" Version="1.1.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RouteDependencyAssembliesToLibrary" BeforeTargets="_CopyFilesMarkedCopyLocal">
    <ItemGroup>
      <ReferenceCopyLocalPaths Update="@(ReferenceCopyLocalPaths)"
                               Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll' and '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == '' and '%(ReferenceCopyLocalPaths.Filename)' != 'IndustrialPark' and '%(ReferenceCopyLocalPaths.Filename)' != 'Randomizer'">
        <DestinationSubDirectory>Library\</DestinationSubDirectory>
      </ReferenceCopyLocalPaths>
    </ItemGroup>
  </Target>
  <Target Name="StageAndPruneOutputAssemblies" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <DependencyAssembliesToMove Include="$(TargetDir)*.dll" Exclude="$(TargetDir)$(TargetName).dll;$(TargetDir)IndustrialPark.dll;$(TargetDir)Randomizer.dll" />
      <SatelliteAssembliesToRemove Include="$(TargetDir)*\*.resources.dll" />
      <SatelliteDirectoriesToRemove Include="@(SatelliteAssembliesToRemove->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)Library" Condition="'@(DependencyAssembliesToMove)' != ''" />
    <Copy SourceFiles="@(DependencyAssembliesToMove)" DestinationFolder="$(TargetDir)Library" SkipUnchangedFiles="true" />
    <Delete Files="@(DependencyAssembliesToMove)" />
    <Delete Files="$(TargetDir)Library\IndustrialPark.dll;$(TargetDir)Library\Randomizer.dll" />
    <Delete Files="@(SatelliteAssembliesToRemove)" />
    <RemoveDir Directories="@(SatelliteDirectoriesToRemove)" />
  </Target>
</Project>